# Alibaba Cloud Model Studio (DashScope / Bailian)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_CHAT_MODEL=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1536

# ElevenLabs API key. Leave empty to disable voice synthesis locally.
ELEVENLABS_API_KEY=

# Supabase project settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated frontend origins allowed by FastAPI CORS.
CORS_ORIGINS=http://localhost:3000

# Number of interview answers before the session is completed.
MAX_TURNS=8
